# SPDX-License-Identifier: GPL-3.0-or-later
# Platform facts stated in the FSD (§2.2). Only what the skeleton needs; PSRAM and the
# component's options arrive with the requirements that use them.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# PSRAM: 8 MB octal on the reference board (FSD §2.2; seen in /commission). The component
# requires it (FR-MEM-01) and the synthesis task's stack lives there.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
