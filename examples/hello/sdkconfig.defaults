# Every chip: a custom partition table with the espeak data partition, English only, PSRAM on.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPIRAM=y
CONFIG_ESPK_LANGUAGES="en"
CONFIG_ESPK_DEFAULT_VOICE="en"
